# ============================================================
# SkyGuard AI — ML Microservice Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

ML_HOST=0.0.0.0
ML_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
MODEL_STORE_DIR=models_store

# Set to false to disable the LSTM model on low-RAM hosts (Render free tier < 512MB)
ENABLE_LSTM=true

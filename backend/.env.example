# ============================================================
# SkyGuard AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# SQLite (default for local dev):
DATABASE_URL="file:./dev.db"

# PostgreSQL / TimescaleDB (for Docker / production):
# DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/skyguard"

PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"

# URL of the Python ML microservice
ML_SERVICE_URL="http://127.0.0.1:8000"

# Optional: Telegram alert bot (leave blank to disable)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_CONFIDENCE_THRESHOLD=0.75

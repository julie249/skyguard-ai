# ====================================================================
# SKYGUARD AI — GLOBAL ENVIRONMENT CONFIGURATION
# ====================================================================

# --- Backend Service (Node.js / Fastify) ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# When running locally without Docker: http://127.0.0.1:8000
# When running inside Docker Compose: http://ml-service:8000
ML_SERVICE_URL=http://127.0.0.1:8000

# Database (PostgreSQL / TimescaleDB)
# Local: postgresql://postgres:postgres@localhost:5432/skyguard
# Docker: postgresql://postgres:postgres@db:5432/skyguard
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skyguard

# Telegram Alerting Integration (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CONFIDENCE_THRESHOLD=0.75

# --- ML Microservice (Python / FastAPI) ---
ML_HOST=0.0.0.0
ML_PORT=8000
